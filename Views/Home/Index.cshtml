@using System.Linq
@model Freshify.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Fresh Groceries";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    int? selectedCategoryId = (int?)ViewBag.SelectedCategoryId;
    string searchText = ViewBag.Search as string ?? "";

    var selectedCategory = Model.Categories.FirstOrDefault(
        c => c.CategoryId == selectedCategoryId
    );

    var heroProduct = Model.Products.FirstOrDefault(
        p => !string.IsNullOrWhiteSpace(p.ImageUrl)
    );

    var isFiltered = selectedCategoryId.HasValue ||
        !string.IsNullOrWhiteSpace(searchText);

    var productsTitle = selectedCategory != null
        ? selectedCategory.CategoryName
        : isFiltered
            ? "Search Results"
            : "Latest Products";
}

@section Styles {
    <style>
        #categories .category-card {
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            height: 100%;
            padding: 22px 16px;
            text-decoration: none;
            transition: border-color .2s, background-color .2s, box-shadow .2s;
        }

            #categories .category-card:hover {
                border-color: #206543;
                background: #f2f8f2;
                box-shadow: 0 6px 18px rgba(32, 101, 67, .07);
            }

            #categories .category-card.is-selected {
                border-color: #206543;
                background: #edf5ee;
            }

        #categories .category-image,
        #categories .category-placeholder {
            width: 100%;
            height: 120px;
            flex-shrink: 0;
            margin-bottom: 16px;
        }

        #categories .category-image {
            object-fit: contain;
        }

        #categories .category-name {
            color: #244b32;
            font-size: 15px;
            font-weight: 750;
            line-height: 1.5;
            margin-bottom: 10px;
            overflow-wrap: anywhere;
        }

        #categories .category-description {
            color: #68766c;
            font-size: 13px;
            line-height: 1.7;
            margin-bottom: 0;
            overflow-wrap: anywhere;
            white-space: pre-line;
        }

        #categories .category-browse {
            display: block;
            margin-top: auto;
            padding-top: 16px;
            color: #206543;
            font-size: 12px;
            font-weight: 700;
        }

        .selected-category-description {
            max-width: 650px;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        @@media (max-width: 575px) {
            #categories .category-card {
                padding: 18px 12px;
            }

            #categories .category-image,
            #categories .category-placeholder {
                height: 100px;
            }

            #categories .category-name {
                font-size: 14px;
            }

            #categories .category-description {
                font-size: 12px;
            }
        }
    </style>
}

<div class="container py-4">

    <!-- BANNER -->
    <section class="hero">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <span class="badge bg-white text-success mb-3">
                    Welcome to Freshify
                </span>

                <h1 class="mb-3">
                    Fresh groceries,<br />
                    for your everyday needs.
                </h1>

                <p class="text-secondary mb-4">
                    Browse vegetables, fruits, dairy, snacks,
                    and kitchen essentials in one place.
                </p>

                <a href="#products"
                   class="btn btn-success px-4">
                    Explore Products
                </a>
            </div>

            <div class="col-md-4 text-center">
                @if (heroProduct != null)
                {
                    <img src="@Url.Content(heroProduct.ImageUrl)"
                         alt="@heroProduct.Name"
                         class="hero-image" />
                }
                else
                {
                    <div class="hero-placeholder"
                         role="img"
                         aria-label="Fresh groceries">
                        🥬
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- CATEGORIES -->
    <section class="py-4 mt-2" id="categories">
        <div class="d-flex justify-content-between align-items-center
            flex-wrap gap-3 mb-4">
            <div>
                <h2 class="section-title mb-2">
                    Browse Categories
                </h2>

                <p class="text-muted small mb-0">
                    Select a category to view its products.
                </p>
            </div>

            @if (isFiltered)
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="products"
                   class="btn btn-outline-success btn-sm">
                    Clear Filters
                </a>
            }
        </div>

        <div class="row g-3 g-lg-4">
            @foreach (var category in Model.Categories)
            {
                var isSelected =
                    selectedCategoryId == category.CategoryId;

                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-route-categoryId="@category.CategoryId"
                       asp-fragment="products"
                       class="category-card w-100 text-center @(isSelected ? "is-selected" : "")">

                        @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                        {
                            <img src="@Url.Content(category.ImageUrl)"
                                 alt=""
                                 class="category-image"
                                 loading="lazy" />
                        }
                        else
                        {
                            <span class="category-placeholder"
                                  aria-hidden="true">
                                🌿
                            </span>
                        }

                        <h3 class="category-name">
                            @category.CategoryName
                        </h3>

                        <p class="category-description">
                            @(string.IsNullOrWhiteSpace(category.Description)
                                ? "Explore products in this category."
                                : category.Description.Trim())
                        </p>

                        <span class="category-browse">
                            @(isSelected
                                ? "Viewing Products"
                                : "Browse Products →")
                        </span>
                    </a>
                </div>
            }
        </div>

        @if (Model.Categories.Count == 0)
        {
            <div class="alert alert-light border text-center">
                No categories available yet.
            </div>
        }
    </section>

    <!-- PRODUCTS -->
    <section class="pb-4" id="products">
        <div class="d-flex justify-content-between align-items-center
            flex-wrap gap-3 mb-4">
            <div>
                <h2 class="section-title mb-1">
                    @productsTitle
                </h2>

                @if (selectedCategory != null &&
                     !string.IsNullOrWhiteSpace(selectedCategory.Description))
                {
                    <p class="small text-muted selected-category-description mb-2">
                        @selectedCategory.Description
                    </p>
                }

                <p class="small text-muted mb-0">
                    @Model.Products.Count product(s) displayed.
                </p>

                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <p class="small text-muted mt-1 mb-0">
                        Search: <strong>@searchText</strong>
                    </p>
                }
            </div>

            <!-- DATABASE SEARCH -->
            <form asp-controller="Home"
                  asp-action="Index"
                  asp-fragment="products"
                  method="get"
                  class="d-flex gap-2"
                  style="width:100%;max-width:360px;">

                @if (selectedCategoryId.HasValue)
                {
                    <input type="hidden"
                           name="categoryId"
                           value="@selectedCategoryId" />
                }

                <label for="productSearch"
                       class="visually-hidden">
                    Search products
                </label>

                <input type="search"
                       id="productSearch"
                       name="search"
                       value="@searchText"
                       class="form-control"
                       placeholder="Search products..." />

                <button type="submit"
                        class="btn btn-success">
                    Search
                </button>
            </form>
        </div>

        <!-- PRODUCT GRID -->
        <div class="row g-3 g-lg-4">
            @foreach (var product in Model.Products)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <article class="product-card d-flex flex-column">
                        <div class="product-art">
                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@Url.Content(product.ImageUrl)"
                                     alt="@product.Name"
                                     loading="lazy" />
                            }
                            else
                            {
                                <span role="img"
                                      aria-label="No product image">
                                    🛍️
                                </span>
                            }

                            @if (product.StockQuantity > 0)
                            {
                                <span class="stock-badge">
                                    In Stock
                                </span>
                            }
                            else
                            {
                                <span class="stock-badge unavailable">
                                    Out of Stock
                                </span>
                            }
                        </div>

                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <p class="small text-muted mb-1">
                                @(product.Category?.CategoryName ?? "Grocery")
                            </p>

                            <h3 class="product-name mb-2">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="text-dark text-decoration-none">
                                    @product.Name
                                </a>
                            </h3>

                            <p class="small text-muted mb-3">
                                @product.Unit
                            </p>

                            <div class="mt-auto border-top pt-2">
                                <div class="product-price mb-3">
                                    ₹@product.Price.ToString("N2")
                                </div>

                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-outline-success btn-sm w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        <!-- EMPTY RESULT -->
        @if (Model.Products.Count == 0)
        {
            <div class="alert alert-light border text-center py-4">
                <p class="mb-3">
                    @(isFiltered
                        ? "No products match this category or search."
                        : "No products available yet.")
                </p>

                @if (isFiltered)
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="products"
                       class="btn btn-outline-success btn-sm">
                        Clear Filters
                    </a>
                }
            </div>
        }
    </section>

    <!-- FEATURES -->
    <section class="mt-3">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="benefit">
                    <h6 class="fw-bold">Fresh Essentials</h6>
                    <p class="small text-muted mb-0">
                        Find produce and daily kitchen staples.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit">
                    <h6 class="fw-bold">Multiple Categories</h6>
                    <p class="small text-muted mb-0">
                        Explore groceries across your favourite categories.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit">
                    <h6 class="fw-bold">Simple Browsing</h6>
                    <p class="small text-muted mb-0">
                        Search products and browse by category.
                    </p>
                </div>
            </div>
        </div>
    </section>

</div>