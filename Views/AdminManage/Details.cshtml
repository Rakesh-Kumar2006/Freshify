@model Freshify.Models.User

@{
    ViewData["Title"] = "Admin Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-person-badge-fill text-success me-2"></i>
                Admin Details
            </h3>

            <p class="text-muted mb-0">
                View administrator account information and profile picture.
            </p>
        </div>

        <a asp-controller="AdminManage"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Admins
        </a>

    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <div class="dashboard-panel p-4">

                <!-- ADMIN PROFILE HEADER -->
                <div class="text-center mb-4">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="Administrator Profile Image"
                             class="rounded-circle mb-3"
                             style="width:120px;
                        height:120px;
                        object-fit:cover;
                        border:4px solid #22c55e;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-success bg-opacity-10
                            d-flex align-items-center justify-content-center
                            mx-auto mb-3"
                             style="width:120px;height:120px;">

                            <i class="bi bi-person-circle text-success"
                               style="font-size:75px;"></i>
                        </div>
                    }

                    <h4 class="fw-bold mb-1">
                        @Model.FullName
                    </h4>

                    <p class="text-muted mb-2">
                        @Model.Email
                    </p>

                    <span class="badge bg-success px-3 py-2">
                        <i class="bi bi-shield-check me-1"></i>
                        Administrator
                    </span>

                </div>

                <hr class="my-4" />

                <!-- ADMIN INFORMATION -->
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-person-lines-fill text-success me-2"></i>
                    Administrator Information
                </h5>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <tbody>

                            <!-- ADMIN ID -->
                            <tr>
                                <th style="width:35%;">
                                    <i class="bi bi-hash text-success me-2"></i>
                                    Admin ID
                                </th>

                                <td>@Model.UserId</td>
                            </tr>

                            <!-- FULL NAME -->
                            <tr>
                                <th>
                                    <i class="bi bi-person text-success me-2"></i>
                                    Full Name
                                </th>

                                <td>@Model.FullName</td>
                            </tr>

                            <!-- EMAIL -->
                            <tr>
                                <th>
                                    <i class="bi bi-envelope text-success me-2"></i>
                                    Email Address
                                </th>

                                <td>@Model.Email</td>
                            </tr>

                            <!-- PHONE -->
                            <tr>
                                <th>
                                    <i class="bi bi-telephone text-success me-2"></i>
                                    Phone Number
                                </th>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                    {
                                        @Model.Phone
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </td>
                            </tr>

                            <!-- ROLE -->
                            <tr>
                                <th>
                                    <i class="bi bi-shield-check text-success me-2"></i>
                                    Role
                                </th>

                                <td>
                                    <span class="badge bg-success">
                                        <i class="bi bi-person-check me-1"></i>
                                        Admin
                                    </span>
                                </td>
                            </tr>

                            <!-- ACCOUNT CREATED -->
                            <tr>
                                <th>
                                    <i class="bi bi-calendar-check text-success me-2"></i>
                                    Account Created
                                </th>

                                <td>
                                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

                <!-- ACTION BUTTONS -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="AdminManage"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back
                    </a>

                    <a asp-controller="AdminManage"
                       asp-action="Edit"
                       asp-route-id="@Model.UserId"
                       class="btn btn-success px-4">

                        <i class="bi bi-pencil-square me-1"></i>
                        Edit Administrator
                    </a>

                </div>

            </div>

        </div>
    </div>

</div>