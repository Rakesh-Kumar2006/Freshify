@model Freshify.ViewModels.AdminProductsViewModel

@{
    ViewData["Title"] = "Product Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-2 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-box-seam text-success me-2"></i>
                Product Management
            </h3>

            <p class="text-muted mb-0">
                Add, update and manage grocery products.
            </p>
        </div>

        <span class="badge bg-success fs-6">
            Total Products: @Model.Products.Count
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ADD PRODUCT FORM -->
    <div class="row justify-content-center mb-4">
        <div class="col-12 col-lg-10 col-xl-9">

            <div class="dashboard-panel p-4">

                <h5 class="fw-bold mb-4">
                    <i class="bi bi-plus-circle-fill text-success me-2"></i>
                    Add Product
                </h5>

                <form asp-controller="AdminProducts"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Product Name
                            </label>
                            <input type="text"
                                   name="Name"
                                   class="form-control"
                                   maxlength="150"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Category
                            </label>

                            <select name="CategoryId"
                                    class="form-select"
                                    required>
                                <option value="">Select Category</option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId">
                                        @category.CategoryName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Price (₹)
                            </label>
                            <input type="number"
                                   name="Price"
                                   class="form-control"
                                   step="0.01"
                                   min="0"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Stock Quantity
                            </label>
                            <input type="number"
                                   name="StockQuantity"
                                   class="form-control"
                                   min="0"
                                   required />
                        </div>

                        <!-- PRODUCT UNIT -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Product Unit
                            </label>

                            <input type="text"
                                   name="Unit"
                                   class="form-control"
                                   placeholder="e.g. 1 kg, 500 g, 1 L, 1 piece"
                                   maxlength="50"
                                   required />

                            <small class="text-muted">
                                Enter the product package size or unit.
                            </small>
                        </div>


                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Description
                            </label>
                            <textarea name="Description"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Product Image
                            </label>
                            <input type="file"
                                   name="Image"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   required />
                            <small class="text-muted">
                                JPG, PNG or WEBP. Maximum 5 MB.
                            </small>
                        </div>

                    </div>

                    <button type="submit"
                            class="btn btn-success w-100 mt-4">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Product
                    </button>

                </form>
            </div>
        </div>
    </div>

    <!-- PRODUCT TABLE -->
    <div class="dashboard-panel">

        <div class="d-flex justify-content-between
            align-items-center flex-wrap gap-2 mb-3">

            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul text-success me-2"></i>
                All Products
            </h5>

            <input type="search"
                   id="productSearch"
                   class="form-control"
                   style="max-width:260px;"
                   placeholder="Search products..." />
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle"
                   id="productTable">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Unit</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        var categoryName = Model.Categories
                            .FirstOrDefault(c =>
                                c.CategoryId == product.CategoryId)
                            ?.CategoryName ?? "-";

                        <tr>
                            <td>@product.ProductId</td>

                            <td>
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     width="65"
                                     height="65"
                                     style="object-fit:contain;border-radius:8px;" />
                            </td>

                            <td class="fw-semibold">
                                @product.Name
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(string.IsNullOrWhiteSpace(product.Unit)
                                        ? "-"
                                        : product.Unit)
                                </span>
                            </td>

                            <td>@categoryName</td>

                            <!-- PRODUCT DESCRIPTION -->
                            <td style="min-width:200px; max-width:300px;">
                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <span class="d-inline-block text-truncate"
                                          style="max-width:280px;"
                                          title="@product.Description">
                                        @product.Description
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No description</span>
                                }
                            </td>


                            <td>₹@product.Price.ToString("N2")</td>

                            <td>
                                @if (product.StockQuantity > 10)
                                {
                                    <span class="badge bg-success">
                                        @product.StockQuantity
                                    </span>
                                }
                                else if (product.StockQuantity > 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @product.StockQuantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Out of Stock
                                    </span>
                                }
                            </td>

                            <td class="text-center">

                              
                               
                                <!-- EDIT PRODUCT -->
                                <a asp-controller="AdminProducts"
                                   asp-action="Edit"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Edit Product">

                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <!-- DELETE ICON -->
                                <form asp-controller="AdminProducts"
                                      asp-action="Delete"
                                      asp-route-id="@product.ProductId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete Product">

                                        <i class="bi bi-trash-fill"></i>
                                    </button>

                                </form>


                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Products.Any())
        {
            <p class="text-center text-muted py-4">
                No products found. Add your first product above.
            </p>
        }

    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("productSearch")
            .addEventListener("input", function () {

                const search = this.value.toLowerCase();

                document.querySelectorAll(
                    "#productTable tbody tr"
                ).forEach(function (row) {

                    row.style.display =
                        row.innerText.toLowerCase().includes(search)
                            ? ""
                            : "none";
                });
            });
    </script>
}