@model Freshify.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var categories = ViewBag.Categories
        as IEnumerable<Freshify.Models.Category>
        ?? Enumerable.Empty<Freshify.Models.Category>();
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-2 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-pencil-square text-success me-2"></i>
                Edit Product
            </h3>

            <p class="text-muted mb-0">
                Update grocery product information.
            </p>
        </div>

        <a asp-controller="AdminProducts"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Products
        </a>
    </div>

    <!-- EDIT PRODUCT FORM -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-9">

            <div class="dashboard-panel p-4">

                <h5 class="fw-bold mb-4">
                    <i class="bi bi-box-seam text-success me-2"></i>
                    Update Product Details
                </h5>

                <form asp-controller="AdminProducts"
                      asp-action="Edit"
                      asp-route-id="@Model.ProductId"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="ProductId"
                           value="@Model.ProductId" />

                    <div class="row g-3">

                        <!-- PRODUCT NAME -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Product Name
                            </label>

                            <input type="text"
                                   name="Name"
                                   value="@Model.Name"
                                   class="form-control"
                                   maxlength="150"
                                   required />
                        </div>

                        <!-- CATEGORY -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Category
                            </label>

                            <select name="CategoryId"
                                    class="form-select"
                                    required>

                                <option value="">Select Category</option>

                                @foreach (var category in categories)
                                {
                                    if (category.CategoryId == Model.CategoryId)
                                    {
                                        <option value="@category.CategoryId"
                                                selected>
                                            @category.CategoryName
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@category.CategoryId">
                                            @category.CategoryName
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- PRICE -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Price (₹)
                            </label>

                            <input type="number"
                                   name="Price"
                                   value="@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control"
                                   step="0.01"
                                   min="0"
                                   required />
                        </div>

                        <!-- STOCK -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Stock Quantity
                            </label>

                            <input type="number"
                                   name="StockQuantity"
                                   value="@Model.StockQuantity"
                                   class="form-control"
                                   min="0"
                                   required />
                        </div>
                        <!-- PRODUCT UNIT -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                Product Unit
                            </label>

                            <input type="text"
                                   name="Unit"
                                   value="@Model.Unit"
                                   class="form-control"
                                   maxlength="50"
                                   placeholder="e.g. 1 kg, 500 g, 1 L"
                                   required />
                        </div>

                        <!-- DESCRIPTION -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea name="Description"
                                      class="form-control"
                                      rows="4">@Model.Description</textarea>
                        </div>

                        <!-- CURRENT IMAGE -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Current Product Image
                            </label>

                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3">
                                    <img src="@Url.Content(Model.ImageUrl)"
                                         alt="@Model.Name"
                                         class="img-thumbnail"
                                         style="width:150px;height:150px;object-fit:contain;" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">
                                    No image uploaded.
                                </p>
                            }
                        </div>

                        <!-- REPLACE IMAGE -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Change Product Image
                            </label>

                            <input type="file"
                                   name="Image"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <small class="text-muted">
                                Leave empty to keep the existing image.
                                Maximum image size: 5 MB.
                            </small>
                        </div>

                    </div>

                    <!-- BUTTONS -->
                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Update Product
                        </button>

                        <a asp-controller="AdminProducts"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </div>

                </form>
            </div>
        </div>
    </div>
</div>