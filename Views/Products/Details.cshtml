@model Freshify.Models.Product

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var maximumQuantity = System.Math.Min(Model.StockQuantity, 1000);
}

@section Styles {
    <style>
        .details-card {
            background: white;
            border: 1px solid #e0e7df;
            border-radius: 16px;
            padding: 30px;
        }

        .details-image {
            height: 420px;
            background: #f1f5ef;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .details-image img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                padding: 20px;
            }

        .details-price {
            font-size: 30px;
            font-weight: 800;
            color: #206543;
        }

        .details-description {
            white-space: pre-line;
            overflow-wrap: anywhere;
            line-height: 1.8;
        }

        .buy-button {
            background: #f2b544;
            border-color: #f2b544;
            color: #382b12;
        }

            .buy-button:hover {
                background: #e6a72f;
                border-color: #e6a72f;
                color: #382b12;
            }

        @@media (max-width: 575px) {
            .details-card {
                padding: 20px;
            }

            .details-image {
                height: 280px;
                min-height: 0;
            }

                .details-image img {
                    height: 100%;
                    padding: 15px;
                }
        }
    </style>
}

<div class="container py-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <div class="details-card">
        <div class="row g-4 align-items-start">

            <!-- PRODUCT IMAGE -->
            <div class="col-md-6">
                <div class="details-image">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Url.Content(Model.ImageUrl)"
                             alt="@Model.Name" />
                    }
                    else
                    {
                        <span class="display-1"
                              role="img"
                              aria-label="No product image">
                            🛍️
                        </span>
                    }
                </div>
            </div>

            <!-- PRODUCT DETAILS -->
            <div class="col-md-6">
                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-categoryId="@Model.CategoryId"
                   class="small text-success text-decoration-none">
                    @(Model.Category?.CategoryName ?? "Grocery")
                </a>

                <h1 class="h3 fw-bold mt-2 mb-3">
                    @Model.Name
                </h1>

                <p class="text-muted">
                    Unit: @Model.Unit
                </p>

                <div class="details-price mb-3">
                    ₹@Model.Price.ToString("N2")
                </div>

                @if (Model.StockQuantity > 0)
                {
                    <span class="badge bg-success mb-3">
                        In Stock
                    </span>
                }
                else
                {
                    <span class="badge bg-danger mb-3">
                        Out of Stock
                    </span>
                }

                <h2 class="h6 fw-bold mt-3">Description</h2>

                <p class="text-muted details-description">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description available."
                    : Model.Description)
                </p>

                @if (Model.StockQuantity > 0)
                {
                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post"
                          class="mt-4">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@Model.ProductId" />

                        <label for="quantity"
                               class="form-label fw-semibold">
                            Quantity
                        </label>

                        <input type="number"
                               id="quantity"
                               name="quantity"
                               value="1"
                               min="1"
                               max="@maximumQuantity"
                               step="1"
                               class="form-control mb-3"
                               style="max-width:120px;"
                               required />

                        <div class="d-flex flex-wrap gap-2">

                            <!-- ADD TO CART -->
                            <button type="submit"
                                    class="btn btn-success px-4">
                                Add to Cart
                            </button>

                            <!-- BUY NOW -->
                            <button type="submit"
                                    asp-controller="Cart"
                                    asp-action="BuyNow"
                                    formmethod="post"
                                    class="btn buy-button px-4">
                                Buy Now
                            </button>

                        </div>
                    </form>
                }
                else
                {
                    <button type="button"
                            class="btn btn-secondary mt-3"
                            disabled>
                        Currently Unavailable
                    </button>
                }

                <a asp-controller="Products"
                   asp-action="Index"
                   class="d-block small text-success mt-4">
                    ← Continue Shopping
                </a>
            </div>

        </div>
    </div>
</div>