@model Freshify.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var initial = string.IsNullOrWhiteSpace(Model.FullName)
        ? "U"
        : Model.FullName.Trim().Substring(0, 1).ToUpperInvariant();
}

@section Styles {
    <style>
        .profile-page {
            max-width: 900px;
            margin: auto;
        }

        .profile-card {
            background: white;
            border: 1px solid #e0e7df;
            border-radius: 16px;
            overflow: hidden;
        }

        .profile-header {
            background: #e8f2e9;
            padding: 28px;
        }

        .profile-photo {
            width: 100px;
            height: 100px;
            flex-shrink: 0;
            border: 3px solid white;
            border-radius: 50%;
            object-fit: cover;
            background: #d8e8d8;
        }

        .profile-photo-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #206543;
            font-size: 38px;
            font-weight: 800;
        }

        .profile-body {
            padding: 28px;
        }

        .profile-section-title {
            font-size: 17px;
            font-weight: 750;
            color: #20583d;
            border-bottom: 1px solid #e8eee5;
            padding-bottom: 12px;
            margin-bottom: 20px;
        }

        .profile-body .form-label {
            font-size: 13px;
            font-weight: 650;
        }

        @@media (max-width: 575px) {
            .profile-header,
            .profile-body {
                padding: 22px;
            }

            .profile-photo {
                width: 80px;
                height: 80px;
            }
        }
    </style>
}

<div class="container py-4">
    <div class="profile-page">

        <h1 class="h3 fw-bold mt-3 mb-4">My Profile</h1>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["Success"]
            </div>
        }

        <div class="profile-card">

            <!-- PROFILE HEADER -->
            <div class="profile-header">
                <div class="d-flex align-items-center flex-wrap gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Url.Content(Model.ImageUrl)"
                             alt="Your profile photo"
                             class="profile-photo" />
                    }
                    else
                    {
                        <div class="profile-photo profile-photo-placeholder"
                             aria-label="Profile initial">
                            @initial
                        </div>
                    }

                    <div>
                        <h2 class="h4 fw-bold mb-1">@Model.FullName</h2>

                        <p class="text-muted small mb-1"
                           style="overflow-wrap:anywhere;">
                            @Model.Email
                        </p>

                        <p class="text-muted small mb-0">
                            Member since @Model.CreatedAt.ToString("dd MMM yyyy")
                        </p>
                    </div>
                </div>
            </div>

            <div class="profile-body">

                <form asp-controller="CustomerAccount"
                      asp-action="MyProfile"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"
                         class="text-danger small mb-3"
                         role="alert"></div>

                    <h3 class="profile-section-title">
                        Personal Information
                    </h3>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName"
                                   class="form-label"></label>
                            <input asp-for="FullName"
                                   class="form-control"
                                   autocomplete="name"
                                   maxlength="100"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email"
                                   class="form-label"></label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="email"
                                   maxlength="150"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone"
                                   class="form-label">
                                Phone Number
                            </label>
                            <input asp-for="Phone"
                                   type="tel"
                                   class="form-control"
                                   autocomplete="tel"
                                   maxlength="15" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageFile"
                                   class="form-label">
                                Replace Profile Photo
                            </label>
                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png" />
                            <div class="form-text">
                                JPG or PNG, up to 5 MB.
                                Leave empty to keep your current photo.
                            </div>
                        </div>
                    </div>

                    <h3 class="profile-section-title">
                        Delivery Address
                    </h3>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="AddressLine"
                                   class="form-label"></label>
                            <textarea asp-for="AddressLine"
                                      class="form-control"
                                      rows="3"
                                      autocomplete="street-address"
                                      maxlength="250"></textarea>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City"
                                   class="form-label"></label>
                            <input asp-for="City"
                                   class="form-control"
                                   autocomplete="address-level2"
                                   maxlength="100" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="State"
                                   class="form-label"></label>
                            <input asp-for="State"
                                   class="form-control"
                                   autocomplete="address-level1"
                                   maxlength="100" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PostalCode"
                                   class="form-label"></label>
                            <input asp-for="PostalCode"
                                   class="form-control"
                                   autocomplete="postal-code"
                                   maxlength="10" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Country"
                                   class="form-label"></label>
                            <input asp-for="Country"
                                   class="form-control"
                                   autocomplete="country-name"
                                   maxlength="100" />
                        </div>
                    </div>

                    <div class="border-top mt-4 pt-4 d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-success px-4">
                            Save Changes
                        </button>

                        <a asp-controller="CustomerAccount"
                           asp-action="MyProfile"
                           class="btn btn-outline-secondary">
                            Reset Changes
                        </a>

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-success">
                            Continue Shopping
                        </a>
                    </div>
                </form>

                <!-- Separate form: do not nest inside the profile form. -->
                <form asp-controller="CustomerAccount"
                      asp-action="Logout"
                      method="post"
                      class="mt-3">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Logout
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>