@model Freshify.ViewModels.CustomerRegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Create Account - Freshify</title>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: #f1f5ef;
                color: #263d30;
                font-family: "Segoe UI", Arial, sans-serif;
                padding: 30px 18px;
            }

            .register-shell {
                width: 100%;
                max-width: 720px;
                margin: auto;
                background: white;
                border: 1px solid #e0e8dc;
                border-radius: 18px;
                overflow: hidden;
                box-shadow: 0 12px 35px rgba(31, 71, 45, .06);
            }

            .form-panel {
                padding: 35px;
            }

            .back-link {
                color: #647568;
                font-size: 13px;
                text-decoration: none;
            }

                .back-link:hover {
                    color: #20583d;
                    text-decoration: underline;
                }

            h1 {
                font-size: 28px;
                font-weight: 750;
            }

            .form-label {
                font-size: 13px;
                font-weight: 650;
            }

            .form-control {
                padding: 10px 12px;
                border-color: #dce4d9;
                font-size: 14px;
                border-radius: 8px;
            }

                .form-control:focus {
                    border-color: #518463;
                    box-shadow: 0 0 0 3px rgba(32, 88, 61, .1);
                }

            .section-heading {
                font-size: 14px;
                font-weight: 750;
                color: #20583d;
                border-bottom: 1px solid #e9eee5;
                padding-bottom: 10px;
                margin: 25px 0 18px;
            }

            .photo-preview {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #dce4d9;
            }

            .register-button {
                background: #20583d;
                color: white;
                border: 0;
                border-radius: 9px;
                padding: 12px;
                width: 100%;
                font-weight: 650;
            }

                .register-button:hover {
                    background: #17442e;
                }

            .login-link {
                color: #20583d;
                font-weight: 700;
                text-decoration: none;
            }

                .login-link:hover {
                    text-decoration: underline;
                }

            [hidden] {
                display: none !important;
            }

            @@media (max-width: 767px) {
                body {
                    padding: 20px 12px;
                }

                .form-panel {
                    padding: 24px;
                }

                h1 {
                    font-size: 25px;
                }
            }
    </style>
</head>

<body>
    <div class="register-shell">
        <main class="form-panel">

            <a asp-controller="Home"
               asp-action="Index"
               class="back-link">
                ← Back to website
            </a>

            <h1 class="mt-4 mb-2">Create Account</h1>

            <p class="text-muted small">
                Enter your details to join Freshify.
            </p>

            <form asp-controller="CustomerAccount"
                  asp-action="Register"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger small mb-3"
                     role="alert"></div>

                <!-- PERSONAL DETAILS -->
                <h2 class="section-heading">Personal Details</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName"
                               class="form-label"></label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Enter your full name"
                               autocomplete="name"
                               maxlength="100"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label"></label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter your email"
                               autocomplete="email"
                               maxlength="150"
                               required />
                    </div>

                    <div class="col-12">
                        <label asp-for="Phone" class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-control"
                               placeholder="Enter your phone number"
                               autocomplete="tel"
                               maxlength="15" />
                    </div>

                    <div class="col-12">
                        <label asp-for="ImageFile" class="form-label">
                            Profile Photo
                        </label>

                        <input asp-for="ImageFile"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png"
                               aria-describedby="photoHelp" />

                        <div id="photoHelp" class="form-text">
                            JPG or PNG. Maximum 5 MB.
                        </div>

                        <div class="mt-3"
                             id="photoPreviewContainer"
                             hidden>

                            <img id="photoPreview"
                                 class="photo-preview"
                                 alt="Selected profile photo" />

                            <button type="button"
                                    id="removePhoto"
                                    class="btn btn-sm btn-outline-secondary ms-2">
                                Remove
                            </button>
                        </div>
                    </div>
                </div>

                <!-- DELIVERY ADDRESS -->
                <h2 class="section-heading">Delivery Address</h2>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="AddressLine"
                               class="form-label"></label>

                        <textarea asp-for="AddressLine"
                                  class="form-control"
                                  placeholder="House number, street, area"
                                  autocomplete="street-address"
                                  rows="2"
                                  maxlength="250"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City"
                               class="form-label"></label>

                        <input asp-for="City"
                               class="form-control"
                               placeholder="Enter city"
                               autocomplete="address-level2"
                               maxlength="100" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="State"
                               class="form-label"></label>

                        <input asp-for="State"
                               class="form-control"
                               placeholder="Enter state"
                               autocomplete="address-level1"
                               maxlength="100" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PostalCode"
                               class="form-label"></label>

                        <input asp-for="PostalCode"
                               class="form-control"
                               placeholder="Enter postal code"
                               autocomplete="postal-code"
                               maxlength="10" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Country"
                               class="form-label"></label>

                        <input asp-for="Country"
                               class="form-control"
                               placeholder="Enter country"
                               autocomplete="country-name"
                               maxlength="100" />
                    </div>
                </div>

                <!-- ACCOUNT SECURITY -->
                <h2 class="section-heading">Account Security</h2>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Password"
                               class="form-label"></label>

                        <div class="input-group">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Create a password"
                                   autocomplete="new-password"
                                   minlength="8"
                                   maxlength="128"
                                   aria-describedby="passwordHelp"
                                   required />

                            <button type="button"
                                    id="togglePassword"
                                    class="btn btn-outline-secondary"
                                    aria-controls="Password ConfirmPassword"
                                    aria-pressed="false">
                                Show
                            </button>
                        </div>

                        <div id="passwordHelp" class="form-text">
                            At least 8 characters.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword"
                               class="form-label"></label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Repeat your password"
                               autocomplete="new-password"
                               minlength="8"
                               maxlength="128"
                               required />
                    </div>
                </div>

                <button type="submit"
                        class="register-button mt-4">
                    Create Account →
                </button>

                <p class="text-center small text-muted mt-4 mb-0">
                    Already have an account?
                    <a asp-controller="CustomerAccount"
                       asp-action="Login"
                       class="login-link">
                        Login
                    </a>
                </p>

            </form>
        </main>
    </div>

    <script>
            const password = document.getElementById("Password");
            const confirmation = document.getElementById("ConfirmPassword");

            document.getElementById("togglePassword")
                .addEventListener("click", function () {
                    const show = password.type === "password";

                    password.type = show ? "text" : "password";
                    confirmation.type = show ? "text" : "password";

                    this.textContent = show ? "Hide" : "Show";
                    this.setAttribute("aria-pressed", String(show));
                });

            function checkPasswords() {
                confirmation.setCustomValidity(
                    confirmation.value &&
                        confirmation.value !== password.value
                        ? "Passwords do not match."
                        : ""
                );
            }

            password.addEventListener("input", checkPasswords);
            confirmation.addEventListener("input", checkPasswords);

            const photoInput = document.getElementById("ImageFile");
            const preview = document.getElementById("photoPreview");
            const previewContainer =
                document.getElementById("photoPreviewContainer");

            let previewUrl = null;

            function clearPhoto() {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                photoInput.value = "";
                preview.removeAttribute("src");
                previewContainer.hidden = true;
            }

            photoInput.addEventListener("change", function () {
                const file = this.files[0];

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                preview.removeAttribute("src");
                previewContainer.hidden = true;

                if (!file) return;

                if (!/\.(jpe?g|png)$/i.test(file.name) ||
                    file.size === 0 ||
                    file.size > 5 * 1024 * 1024) {
                    clearPhoto();
                    alert("Select a JPG or PNG image up to 5 MB.");
                    return;
                }

                previewUrl = URL.createObjectURL(file);
                preview.src = previewUrl;
                previewContainer.hidden = false;
            });

            document.getElementById("removePhoto")
                .addEventListener("click", clearPhoto);
    </script>
</body>
</html>