@model IEnumerable<Freshify.Models.Category>

@{
    ViewData["Title"] = "Category Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-grid-fill text-success me-2"></i>
                Category Management
            </h3>

            <p class="text-muted mb-0">
                Add, view, update and delete grocery categories.
            </p>
        </div>

        <span class="badge bg-success fs-6">
            Total Categories: @Model.Count()
        </span>
    </div>

    <!-- SUCCESS AND ERROR MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- ADD CATEGORY FORM -->
    <div class="row justify-content-center mb-4">
        <div class="col-12 col-lg-10 col-xl-9">

            <div class="dashboard-panel p-4">

                <h5 class="fw-bold mb-4">
                    <i class="bi bi-plus-circle-fill text-success me-2"></i>
                    Add Category
                </h5>

                <form asp-controller="AdminCategories"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <!-- CATEGORY NAME -->
                    <div class="mb-3">
                        <label for="CategoryName"
                               class="form-label fw-semibold">
                            Category Name
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="CategoryName"
                               name="CategoryName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter category name"
                               required />
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="mb-3">
                        <label for="Description"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea id="Description"
                                  name="Description"
                                  class="form-control"
                                  maxlength="500"
                                  rows="4"
                                  placeholder="Enter category description"></textarea>
                    </div>

                    <!-- CATEGORY IMAGE UPLOAD -->
                    <div class="mb-4">
                        <label for="ImageFile"
                               class="form-label fw-semibold">
                            Category Image
                            <span class="text-muted fw-normal">
                                (Optional)
                            </span>
                        </label>

                        <input type="file"
                               id="ImageFile"
                               name="ImageFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               onchange="previewCategoryImage(event)" />

                        <div class="form-text">
                            Supported formats: JPG, JPEG, PNG, WEBP.
                            Maximum size: 5 MB.
                        </div>

                        <!-- IMAGE PREVIEW -->
                        <div class="mt-3"
                             id="imagePreviewContainer"
                             style="display:none;">

                            <p class="fw-semibold mb-2">
                                Image Preview
                            </p>

                            <div class="position-relative d-inline-block">

                                <img id="categoryImagePreview"
                                     alt="Selected category image"
                                     class="rounded border shadow-sm"
                                     style="width:180px;height:150px;object-fit:cover;" />

                                <button type="button"
                                        class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1"
                                        title="Remove selected image"
                                        onclick="removeCategoryImage()">

                                    <i class="bi bi-x-lg"></i>
                                </button>

                            </div>
                        </div>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit"
                            class="btn btn-success w-100">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Category
                    </button>

                </form>

            </div>
        </div>
    </div>

    <!-- CATEGORY TABLE -->
    <div class="row">
        <div class="col-12">

            <div class="dashboard-panel">

                <!-- TABLE HEADER -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-list-ul text-success me-2"></i>
                        All Categories
                    </h5>

                    <!-- SEARCH -->
                    <input type="search"
                           id="categorySearch"
                           class="form-control"
                           style="max-width:260px;"
                           placeholder="Search categories..." />
                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle"
                           id="categoryTable">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Image</th>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Any())
                            {
                                foreach (var category in Model)
                                {
                                    <tr>

                                        <!-- CATEGORY ID -->
                                        <td>
                                            @category.CategoryId
                                        </td>

                                        <!-- CATEGORY IMAGE -->
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                                            {
                                                <img src="@Url.Content(category.ImageUrl)"
                                                     alt="@category.CategoryName"
                                                     class="rounded border shadow-sm"
                                                     style="width:80px;height:65px;object-fit:cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light border rounded d-flex align-items-center justify-content-center"
                                                     style="width:80px;height:65px;">

                                                    <i class="bi bi-image text-secondary fs-3"></i>

                                                </div>
                                            }
                                        </td>

                                        <!-- CATEGORY NAME -->
                                        <td class="fw-semibold">
                                            @category.CategoryName
                                        </td>

                                        <!-- DESCRIPTION -->
                                        <td>
                                            @(string.IsNullOrWhiteSpace(category.Description)
                                                ? "-"
                                                : category.Description)
                                        </td>

                                        <!-- ACTIONS -->
                                        <td class="text-center">

                                            <!-- EDIT CATEGORY -->
                                            <a asp-controller="AdminCategories"
                                               asp-action="Edit"
                                               asp-route-id="@category.CategoryId"
                                               class="btn btn-sm btn-outline-primary me-1"
                                               title="Edit Category">

                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- DELETE CATEGORY -->
                                            <form asp-controller="AdminCategories"
                                                  asp-action="Delete"
                                                  asp-route-id="@category.CategoryId"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this category?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete Category">

                                                    <i class="bi bi-trash-fill"></i>
                                                </button>

                                            </form>

                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5"
                                        class="text-center text-muted py-4">

                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                        No categories found.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {

    <script>

        // CATEGORY SEARCH
        const searchInput =
            document.getElementById("categorySearch");

        searchInput.addEventListener("input", function () {

            const search = this.value.toLowerCase();

            document.querySelectorAll(
                "#categoryTable tbody tr"
            ).forEach(function (row) {

                const text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(search) ? "" : "none";
            });
        });


        // CATEGORY IMAGE PREVIEW
        function previewCategoryImage(event) {

            const input = event.target;
            const file = input.files[0];

            const preview =
                document.getElementById("categoryImagePreview");

            const container =
                document.getElementById("imagePreviewContainer");

            if (!file) {
                removeCategoryImage();
                return;
            }

            const allowedExtensions = [
                ".jpg", ".jpeg", ".png", ".webp"
            ];

            const fileName = file.name.toLowerCase();

            const validExtension = allowedExtensions.some(
                extension => fileName.endsWith(extension)
            );

            if (!validExtension) {
                alert("Please select a JPG, PNG or WEBP image.");
                removeCategoryImage();
                return;
            }

            // MAXIMUM IMAGE SIZE: 5 MB
            if (file.size > 5 * 1024 * 1024) {
                alert("Image size cannot exceed 5 MB.");
                removeCategoryImage();
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {

                preview.src = e.target.result;

                container.style.display = "block";
            };

            reader.readAsDataURL(file);
        }


        // REMOVE SELECTED IMAGE
        function removeCategoryImage() {

            const input =
                document.getElementById("ImageFile");

            const preview =
                document.getElementById("categoryImagePreview");

            const container =
                document.getElementById("imagePreviewContainer");

            input.value = "";

            preview.removeAttribute("src");

            container.style.display = "none";
        }

    </script>
}